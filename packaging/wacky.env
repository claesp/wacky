# Settings for the wacky service.
#
# Every command-line flag has a WACKY_ variable; the full list is in
# /usr/share/doc/wacky/README.md. Uncommented lines below are the ones worth
# deciding on before starting the service.

# The repository to serve. The package creates this directory empty — clone
# into it, or point this at a repository you already have. wacky never writes
# to it, so it may be read-only.
WACKY_GIT_REPO=/var/lib/wacky/repo

# Listen address. The default binds loopback only: put a reverse proxy in
# front, or set 0.0.0.0:8080 to serve directly.
WACKY_ADDR=127.0.0.1:8080

# How often the page index is rebuilt. Whatever keeps the repository up to
# date — a cron job running git pull, for instance — is noticed within this.
WACKY_RELOAD_INTERVAL=15s

# Serve a fixed revision instead of the working tree.
#WACKY_GIT_REF=main

# Branding.
#WACKY_BRAND_TITLE=Wacky
#WACKY_BRAND_COLOR=#1f5fa8
#WACKY_OWNER=The Authors

# Link commit hashes to a hosting site.
#WACKY_GIT_COMMIT_URL=https://github.com/org/repo/commit/

# Classification banners and dots, off unless a threshold is set.
#WACKY_CLASSIFICATION_THRESHOLD_LOW=2
#WACKY_CLASSIFICATION_THRESHOLD_HIGH=5

# debug, info, warn or error.
WACKY_LOG_LEVEL=info
