{{define "content" -}}
{{template "breadcrumbs" dict "Trail" .Breadcrumbs "Path" .Path}}

<article class="page">
  <h1>Pages</h1>

  {{if .Pages}}
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Title</th><th>Path</th><th>Modified</th></tr>
      </thead>
      <tbody>
        {{- range .Pages}}
        <tr>
          <td><a href="{{.URL}}">{{template "dot" index $.Dots .Path}}{{.Title}}</a></td>
          <td><code>{{.Path}}</code></td>
          <td title="{{formatTime .ModTime}}">{{relativeTime .ModTime}}</td>
        </tr>
        {{- end}}
      </tbody>
    </table>
  </div>
  {{else}}
  <p>No Markdown files were found in this repository.</p>
  {{end}}
</article>
{{- end}}
