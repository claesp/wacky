{{define "content" -}}
{{template "breadcrumbs" dict "Trail" .Breadcrumbs "Path" .Path}}

<article class="page">
  <h1>{{.Heading}}</h1>
  <h2>History</h2>

  {{if .Commits}}
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Commit</th><th>When</th><th>Author</th><th>Subject</th></tr>
      </thead>
      <tbody>
        {{- range .Commits}}
        <tr>
          <td>{{template "commit" dict "URL" $.CommitURL "Commit" .}}</td>
          <td>{{formatTime .When}}</td>
          <td>{{.Author}}</td>
          <td>{{.Subject}}</td>
        </tr>
        {{- end}}
      </tbody>
    </table>
  </div>
  {{else}}
  <p>This file has no commits yet.</p>
  {{end}}
</article>

{{template "page-meta" dict "Path" .RepoPath "Commit" .LastCommit "HasHistory" .HasHistory "CommitURL" .CommitURL}}
{{- end}}
