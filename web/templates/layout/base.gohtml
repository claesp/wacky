{{define "base.gohtml" -}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{with .PageTitle}}{{.}} &middot; {{end}}{{.Site}}</title>
<link rel="stylesheet" href="/static/style.css?v={{.Assets}}">
<link rel="icon" href="data:,">
</head>
<body>
<a class="skip" href="#content">Skip to content</a>

{{/* The menu toggle is a checkbox so the navigation opens without JavaScript,
     which the Content-Security-Policy forbids. It sits before .topbar and
     .shell so CSS can reach the sidebar with a sibling combinator. */}}
<input class="menu-toggle visually-hidden" type="checkbox" id="menu-toggle">

<header class="topbar">
  <label class="menu-button" for="menu-toggle">
    <svg viewBox="0 0 20 14" width="20" height="14" aria-hidden="true" focusable="false">
      <rect width="20" height="2" rx="1"></rect>
      <rect y="6" width="20" height="2" rx="1"></rect>
      <rect y="12" width="20" height="2" rx="1"></rect>
    </svg>
    <span class="visually-hidden">Menu</span>
  </label>
  <a class="brand" href="/">{{.Site}}</a>
  {{if .Ref}}<span class="ref" title="Serving a pinned revision">{{.Ref}}</span>{{end}}
  {{/* No submit button: the form has a single field, so pressing Enter (or a
       phone keyboard's Search key) submits it. */}}
  <form class="search" action="/search" method="get" role="search">
    <label class="visually-hidden" for="q">Search the wiki</label>
    <input id="q" name="q" type="search" placeholder="Search&hellip;" value="{{.Query}}">
  </form>
</header>

<div class="shell">
  <aside class="sidebar">
    <h2 class="sidebar-title">Contents</h2>
    {{template "nav" .}}
  </aside>

  <main id="content">
    {{template "content" .}}
  </main>
</div>

<footer class="footer">
  <span>{{.Stats.Pages}} pages</span>
  <span>&middot;</span>
  <span title="{{.Stats.Root}}">{{.Stats.Head.Subject}}</span>
  {{with .Stats.Head.Short}}<span>&middot;</span><code>{{.}}</code>{{end}}
  <span>&middot;</span>
  <span>indexed {{formatTime .Stats.LoadedAt}}</span>
</footer>
</body>
</html>
{{- end}}
