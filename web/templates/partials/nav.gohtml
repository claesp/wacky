{{/* The fixed entries first, then the repository tree, with a rule between
     them. The rule is a border on the last fixed item rather than an <hr>,
     which is not a valid child of a list, and is left off entirely when there
     is no tree below it to separate. */}}
{{define "nav" -}}
<ul class="nav">
  <li><a href="/"{{if eq .Path "/"}} class="active" aria-current="page"{{end}}>Home</a></li>
  <li{{if .Nav}} class="nav-divide"{{end}}><a href="/pages"{{if eq .Path "/pages"}} class="active" aria-current="page"{{end}}>Pages</a></li>
  {{- range .Nav}}
  {{template "nav-node" dict "Node" . "Current" $.Slug}}
  {{- end}}
</ul>
{{/* Keyed off the page count, not the tree: a repository whose only page is a
     root README has an empty tree but is not empty. */}}
{{- if eq .Stats.Pages 0}}
<p class="muted">This repository contains no Markdown files.</p>
{{- end -}}
{{- end}}

{{define "nav-node" -}}
{{- $node := .Node -}}
{{- $current := .Current -}}
<li>
  {{- if or $node.Page (not $node.IsDir)}}
  <a href="{{$node.URL}}"{{if eq $node.Slug $current}} class="active" aria-current="page"{{end}}>{{$node.Name}}</a>
  {{- else}}
  <span class="nav-dir">{{$node.Name}}</span>
  {{- end}}
  {{- if $node.IsDir}}
  <ul>
    {{- range $node.Children}}
    {{template "nav-node" dict "Node" . "Current" $current}}
    {{- end}}
  </ul>
  {{- end}}
</li>
{{- end}}

{{/* Takes a dict of "Trail" (the crumbs below Home) and "Path" (the current
     request path). The Home crumb is always rendered, so every page starts its
     trail the same way, including Home itself. */}}
{{define "breadcrumbs" -}}
{{- $path := .Path -}}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/"{{if eq $path "/"}} aria-current="page"{{end}}>Home</a>
  {{- range .Trail}}
  <span aria-hidden="true">/</span>
  <a href="{{.URL}}"{{if eq $path (urlPath .URL)}} aria-current="page"{{end}}>{{.Name}}</a>
  {{- end}}
</nav>
{{- end}}

{{define "toc" -}}
{{- if gt (len .) 1 -}}
<nav class="toc" aria-label="On this page">
  <h2>On this page</h2>
  <ul>
    {{- range .}}
    {{- if le .Level 3}}
    <li class="toc-l{{.Level}}"><a href="#{{.ID}}">{{.Text}}</a></li>
    {{- end}}
    {{- end}}
  </ul>
</nav>
{{- end -}}
{{- end}}
